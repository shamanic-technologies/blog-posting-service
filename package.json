{
  "name": "@shamanic-technologies/blog-posting-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run generate:openapi",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "postgres": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "path-to-regexp@0": "^0.1.13",
    "body-parser@1": "^1.20.8",
    "qs": "^6.16.1",
    "form-data@4": "^4.0.6",
    "nanoid@3": "^3.3.20",
    "picomatch@4": "^4.0.7",
    "postcss@8": "^8.5.31",
    "rollup@4": "^4.64.12",
    "source-map-js@1": "^1.2.2",
    "vite@7": "^7.3.7",
    "yaml@2": "^2.9.1"
  }
}
